# Copy to .env or set these in your shell. Never commit real values to .env.

# Required only to publish the dataset or model with scripts/push_to_hub.py --push.
HF_TOKEN=

# Set in Hugging Face Space Settings so GitHub Pages can call the backend directly.
WW_CORS_ORIGINS=https://your-github-user.github.io

# Optional: direct frontend API calls outside local Next.js development.
NEXT_PUBLIC_API_BASE=https://your-space.hf.space
